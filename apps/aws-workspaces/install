#!/bin/bash
set -e

mkdir -p "$HOME/.local/share/applications" "$HOME/.local/share/icons/hicolor/192x192/apps"

cat > "$HOME/.local/share/applications/aws-workspaces.desktop" <<'DESKTOP'
[Desktop Entry]
Name=AWS WorkSpaces Client
Exec=workspacesclient
Icon=aws-workspaces
Type=Application
Categories=Network;RemoteAccess;
DESKTOP

echo "Installed desktop entry"
